# Copy to .env.local for development. On Vercel, add these under
# Project Settings > Environment Variables.

# Canonical origin for metadata, sitemap and RSS.
NEXT_PUBLIC_SITE_URL=https://blog.betterpuertoprincesa.org

# Firebase web app config (Firebase console > Project settings > Your apps).
# These are safe to expose; access is controlled by rules and server checks.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account for the server (Project settings > Service accounts >
# Generate new private key). Keep these secret.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Vercel Blob, for images in posts. Vercel adds this automatically once a
# Blob store is connected to the project. For local dev, run
# `vercel env pull .env.local` or copy it from the store's settings.
BLOB_READ_WRITE_TOKEN=
